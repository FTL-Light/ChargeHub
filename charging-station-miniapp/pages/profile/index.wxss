.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
}

/* 用户信息头部 */
.user-header {
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.2);
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  font-size: 44rpx;
  color: #ffffff;
  margin-right: 24rpx;
  font-weight: bold;
}

.default-avatar {
  font-size: 56rpx;
  line-height: 100rpx;
}

.user-detail {
  flex: 1;
}

.nickname {
  font-size: 34rpx;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.phone {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.login-arrow {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 200;
}

/* 余额卡片 */
.balance-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.balance-info {
  flex: 1;
}

.balance-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.balance-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b00;
}

.recharge-btn {
  padding: 16rpx 40rpx;
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

/* 菜单 */
.menu-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 0 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
  font-weight: 200;
}

/* 退出登录 */
.logout-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  background: #ffffff;
  color: #ff4d4f;
  font-size: 30rpx;
  border-radius: 45rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
