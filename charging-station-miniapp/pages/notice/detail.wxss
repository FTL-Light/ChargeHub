.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
}

.notice-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.notice-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.notice-meta {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.notice-type {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
}

.type-system {
  color: #1890ff;
  background: rgba(24, 144, 255, 0.1);
}

.type-activity {
  color: #ff6b00;
  background: rgba(255, 107, 0, 0.1);
}

.type-notice {
  color: #52c41a;
  background: rgba(82, 196, 26, 0.1);
}

.notice-time {
  font-size: 24rpx;
  color: #999;
}

.notice-source {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 24rpx 0;
}

.notice-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.notice-image {
  width: 100%;
  border-radius: 12rpx;
  margin-top: 24rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
