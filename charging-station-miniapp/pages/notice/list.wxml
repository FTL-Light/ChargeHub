<view class="container">
  <!-- 公告列表 -->
  <view class="notice-list" wx:if="{{notices.length > 0}}">
    <view
      class="notice-card"
      wx:for="{{notices}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onNoticeTap"
    >
      <view class="notice-header">
        <text class="notice-type type-{{item.type}}">
          {{item.type === 'system' ? '系统' : item.type === 'activity' ? '活动' : item.type === 'notice' ? '公告' : item.type || '公告'}}
        </text>
        <text class="notice-arrow">›</text>
      </view>
      <view class="notice-title">{{item.title}}</view>
      <view class="notice-summary" wx:if="{{item.summary}}">{{item.summary}}</view>
      <view class="notice-time">{{item.createTime || item.publishTime || item.time}}</view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="load-more" wx:if="{{!hasMore && notices.length > 0}}">
      <text>没有更多了</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && notices.length === 0}}">
    <view class="empty-icon">📢</view>
    <view class="empty-text">暂无公告</view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading && notices.length === 0}}">
    <view class="loading-text">加载中...</view>
  </view>
</view>
