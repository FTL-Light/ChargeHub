.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
}

/* 状态卡片 */
.status-card {
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  border-radius: 20rpx;
  padding: 50rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.2);
}

.status-icon {
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  font-size: 56rpx;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.status-text {
  font-size: 34rpx;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.status-amount {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: bold;
}

/* 信息卡片 */
.info-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  width: 180rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  word-break: break-all;
}

.copy-btn {
  font-size: 22rpx;
  color: #1890ff;
  padding: 4rpx 16rpx;
  border: 1rpx solid #1890ff;
  border-radius: 20rpx;
  margin-left: 16rpx;
}

.total-row {
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 10rpx;
}

.total-row .info-label {
  color: #333;
  font-weight: bold;
}

.total-amount {
  font-size: 36rpx;
  color: #ff6b00;
  font-weight: bold;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
