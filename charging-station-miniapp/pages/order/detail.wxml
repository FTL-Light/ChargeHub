<view class="container" wx:if="{{!loading}}">
  <!-- 订单状态卡片 -->
  <view class="status-card">
    <view class="status-icon">
      {{order.status === 'charging' ? '⚡' : order.status === 'completed' ? '✓' : order.status === 'cancelled' ? '×' : '¥'}}
    </view>
    <view class="status-text">
      {{order.status === 'charging' ? '充电中' : order.status === 'completed' ? '已完成' : order.status === 'cancelled' ? '已取消' : order.status === 'pending' ? '待支付' : order.status}}
    </view>
    <view class="status-amount" wx:if="{{order.status === 'completed' || order.status === 'pending'}}">
      ¥{{order.amount || order.totalAmount || '0.00'}}
    </view>
  </view>

  <!-- 订单基本信息 -->
  <view class="info-card">
    <view class="card-title">订单信息</view>
    <view class="info-row">
      <text class="info-label">订单号</text>
      <text class="info-value">{{order.orderNo || order.id}}</text>
      <text class="copy-btn" bindtap="onCopyNo">复制</text>
    </view>
    <view class="info-row">
      <text class="info-label">下单时间</text>
      <text class="info-value">{{order.createTime || '-'}}</text>
    </view>
    <view class="info-row" wx:if="{{order.payTime}}">
      <text class="info-label">支付时间</text>
      <text class="info-value">{{order.payTime}}</text>
    </view>
  </view>

  <!-- 充电信息 -->
  <view class="info-card">
    <view class="card-title">充电信息</view>
    <view class="info-row">
      <text class="info-label">充电站点</text>
      <text class="info-value">{{order.stationName || order.station || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">充电桩编号</text>
      <text class="info-value">{{order.chargerNo || order.chargerCode || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">充电桩类型</text>
      <text class="info-value">{{order.chargerType || order.type || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">开始时间</text>
      <text class="info-value">{{order.startTime || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">结束时间</text>
      <text class="info-value">{{order.endTime || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">充电时长</text>
      <text class="info-value">{{order.durationText || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">充电量</text>
      <text class="info-value">{{order.electricity || order.energy || '0'}} kWh</text>
    </view>
  </view>

  <!-- 费用信息 -->
  <view class="info-card">
    <view class="card-title">费用明细</view>
    <view class="info-row">
      <text class="info-label">单价</text>
      <text class="info-value">¥{{order.unitPrice || order.price || '0.00'}}/度</text>
    </view>
    <view class="info-row">
      <text class="info-label">电费</text>
      <text class="info-value">¥{{order.electricityFee || order.elecFee || '0.00'}}</text>
    </view>
    <view class="info-row" wx:if="{{order.serviceFee}}">
      <text class="info-label">服务费</text>
      <text class="info-value">¥{{order.serviceFee}}</text>
    </view>
    <view class="info-row total-row">
      <text class="info-label">合计金额</text>
      <text class="info-value total-amount">¥{{order.amount || order.totalAmount || '0.00'}}</text>
    </view>
  </view>
</view>

<!-- 加载中 -->
<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
