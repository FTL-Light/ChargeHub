<view class="container">
  <!-- 状态筛选 tabs -->
  <view class="tabs">
    <view
      class="tab-item {{currentTab === index ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="index"
      data-index="{{index}}"
      bindtap="onTabChange"
    >
      <text>{{item.name}}</text>
      <view class="tab-line" wx:if="{{currentTab === index}}"></view>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view
      class="order-card"
      wx:for="{{orders}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOrderTap"
    >
      <view class="order-header">
        <text class="order-no">订单号：{{item.orderNo || item.id}}</text>
        <text class="order-status status-{{item.status}}">
          {{item.status === 'charging' ? '充电中' : item.status === 'completed' ? '已完成' : item.status === 'cancelled' ? '已取消' : item.status === 'pending' ? '待支付' : item.status}}
        </text>
      </view>
      <view class="order-body">
        <view class="order-row">
          <text class="row-label">站点</text>
          <text class="row-value">{{item.stationName || item.station || '-'}}</text>
        </view>
        <view class="order-row">
          <text class="row-label">充电桩</text>
          <text class="row-value">{{item.chargerNo || item.chargerCode || '-'}}</text>
        </view>
        <view class="order-row">
          <text class="row-label">充电时间</text>
          <text class="row-value">{{item.startTime || item.createTime || '-'}}</text>
        </view>
      </view>
      <view class="order-footer">
        <view class="order-amount">
          <text class="amount-label">订单金额</text>
          <text class="amount-value">¥{{item.amount || item.totalAmount || '0.00'}}</text>
        </view>
        <view class="order-arrow">›</view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="load-more" wx:if="{{!hasMore && orders.length > 0}}">
      <text>没有更多了</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && orders.length === 0}}">
    <view class="empty-icon">📋</view>
    <view class="empty-text">暂无订单</view>
    <view class="empty-desc">快去扫码充电吧</view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading && orders.length === 0}}">
    <view class="loading-text">加载中...</view>
  </view>
</view>
