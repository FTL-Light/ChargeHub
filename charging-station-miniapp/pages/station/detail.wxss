.container {
  padding-bottom: 30rpx;
}

/* 站点头部 */
.station-header {
  background: #ffffff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.station-cover {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
  margin-bottom: 24rpx;
}

.station-base {
  width: 100%;
}

.station-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.station-status-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
}

.status-tag.online {
  color: #52c41a;
  background: rgba(82, 196, 26, 0.1);
}

.status-tag.offline {
  color: #999;
  background: rgba(0, 0, 0, 0.05);
}

.open-time {
  font-size: 24rpx;
  color: #666;
}

.station-addr {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.station-phone {
  font-size: 26rpx;
  color: #1890ff;
}

/* 充电桩列表 */
.chargers-section {
  background: #ffffff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.title-count {
  font-size: 24rpx;
  color: #999;
}

.charger-list {
  width: 100%;
}

.charger-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.charger-item:last-child {
  border-bottom: none;
}

.charger-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.charger-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  border-radius: 12rpx;
  font-size: 36rpx;
  margin-right: 20rpx;
  color: #ffffff;
}

.charger-info {
  flex: 1;
}

.charger-no {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.charger-type {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.charger-meta {
  display: flex;
  align-items: center;
}

.meta-power {
  font-size: 24rpx;
  color: #1890ff;
  margin-right: 20rpx;
}

.meta-price {
  font-size: 24rpx;
  color: #ff6b00;
}

.charger-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.charger-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}

.status-0, .status-空闲 {
  color: #52c41a;
  background: rgba(82, 196, 26, 0.1);
}

.status-1, .status-使用中 {
  color: #faad14;
  background: rgba(250, 173, 20, 0.1);
}

.status-2, .status-故障, .status-3, .status-离线 {
  color: #999;
  background: rgba(0, 0, 0, 0.05);
}

.charge-btn {
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  color: #ffffff;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
}

.charge-btn.disabled {
  background: #d9d9d9;
  color: #999;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}

.bottom-placeholder {
  height: 120rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #eee;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.bottom-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  margin: 0 10rpx;
}

.call-btn {
  background: #f5f5f5;
  color: #333;
}

.nav-btn {
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  color: #ffffff;
}

.btn-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
