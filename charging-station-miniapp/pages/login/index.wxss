.container {
  min-height: 100vh;
  padding: 60rpx 50rpx;
  box-sizing: border-box;
  background: #ffffff;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo-icon {
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  text-align: center;
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  border-radius: 36rpx;
  font-size: 80rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3);
}

.logo-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.logo-desc {
  font-size: 26rpx;
  color: #999;
}

/* 表单区域 */
.form-section {
  width: 100%;
}

.form-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
}

/* tab切换 */
.tab-section {
  display: flex;
  margin-bottom: 50rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: #999;
  position: relative;
}

.tab-item.active {
  color: #1890ff;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  left: 50%;
  margin-left: -40rpx;
  width: 80rpx;
  height: 4rpx;
  background: #1890ff;
  border-radius: 2rpx;
}

/* 微信登录 */
.wechat-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.wechat-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  text-align: center;
  background: #07c160;
  border-radius: 50%;
  font-size: 64rpx;
  margin-bottom: 30rpx;
}

.wechat-text {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.wechat-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 60rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 36rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
  height: 96rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 0 30rpx;
}

.input-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.form-input {
  flex: 1;
  height: 96rpx;
  font-size: 30rpx;
  color: #333;
}

/* 主按钮 */
.primary-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  color: #ffffff;
  font-size: 34rpx;
  border-radius: 48rpx;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3);
}

.primary-btn.wechat-btn {
  background: #07c160;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}

.primary-btn.disabled {
  background: #d9d9d9;
  color: #999;
  box-shadow: none;
}

/* 切换文本 */
.switch-text {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  margin-top: 40rpx;
}

.switch-link {
  color: #1890ff;
}

/* 协议 */
.agreement {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 60rpx;
  line-height: 1.6;
}

.agreement-link {
  color: #1890ff;
}
