.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* 聊天区域 */
.chat-area {
  flex: 1;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

.msg-list {
  padding-bottom: 20rpx;
}

.msg-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.msg-assistant {
  flex-direction: row;
}

.msg-user {
  flex-direction: row-reverse;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 40rpx;
  background: #ffffff;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.msg-bubble {
  max-width: 480rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  margin: 0 16rpx;
  word-break: break-all;
}

.bubble-assistant {
  background: #ffffff;
  color: #333;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.bubble-user {
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  color: #ffffff;
  border-top-right-radius: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.2);
}

.msg-content {
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

/* 加载中气泡 */
.loading-bubble {
  display: flex;
  align-items: center;
}

.loading-dots {
  display: flex;
  align-items: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #ccc;
  border-radius: 50%;
  margin: 0 6rpx;
  animation: dotBounce 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.6; }
  40% { transform: scale(1); opacity: 1; }
}

/* 快捷问题 */
.quick-questions {
  margin: 20rpx 0;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.quick-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
}

.quick-item {
  font-size: 26rpx;
  color: #1890ff;
  background: rgba(24, 144, 255, 0.08);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.bottom-placeholder {
  height: 20rpx;
}

/* 底部输入区域 */
.input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eee;
}

.msg-input {
  flex: 1;
  height: 72rpx;
  background: #f5f7fa;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333;
}

.send-btn {
  margin-left: 20rpx;
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 36rpx;
}

.send-btn.disabled {
  background: #d9d9d9;
  color: #999;
}
