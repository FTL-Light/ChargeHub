<view class="container">
  <!-- 反馈表单 -->
  <view class="form-card">
    <view class="card-title">提交反馈</view>

    <!-- 类型选择 -->
    <view class="form-item">
      <view class="form-label">反馈类型</view>
      <picker mode="selector" range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="picker-value">
          {{typeOptions[typeIndex].label}}
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 标题 -->
    <view class="form-item">
      <view class="form-label">标题</view>
      <input
        class="form-input"
        placeholder="请简要描述问题"
        value="{{form.title}}"
        bindinput="onTitleInput"
        maxlength="50"
      />
    </view>

    <!-- 内容 -->
    <view class="form-item">
      <view class="form-label">问题描述</view>
      <textarea
        class="form-textarea"
        placeholder="请详细描述您遇到的问题，便于我们快速处理"
        value="{{form.content}}"
        bindinput="onContentInput"
        maxlength="500"
      />
      <view class="textarea-count">{{form.content.length}}/500</view>
    </view>

    <!-- 图片上传 -->
    <view class="form-item">
      <view class="form-label">图片（最多4张）</view>
      <view class="image-list">
        <view class="image-item" wx:for="{{form.images}}" wx:key="*this">
          <image
            src="{{item}}"
            mode="aspectFill"
            data-src="{{item}}"
            bindtap="previewImage"
          ></image>
          <view class="image-delete" data-index="{{index}}" catchtap="deleteImage">×</view>
        </view>
        <view class="image-add" wx:if="{{form.images.length < 4}}" bindtap="chooseImage">
          <text class="add-icon">+</text>
          <text class="add-text">添加图片</text>
        </view>
      </view>
    </view>

    <!-- 联系电话 -->
    <view class="form-item">
      <view class="form-label">联系电话</view>
      <input
        class="form-input"
        type="number"
        placeholder="便于我们与您联系"
        value="{{form.phone}}"
        bindinput="onPhoneInput"
        maxlength="11"
      />
    </view>

    <!-- 提交按钮 -->
    <view
      class="submit-btn {{submitting ? 'disabled' : ''}}"
      bindtap="submitFeedback"
    >
      {{submitting ? '提交中...' : '提交反馈'}}
    </view>
  </view>

  <!-- 历史反馈 -->
  <view class="history-card">
    <view class="card-title">历史反馈</view>
    <view class="history-list" wx:if="{{feedbackList.length > 0}}">
      <view class="history-item" wx:for="{{feedbackList}}" wx:key="id">
        <view class="history-header">
          <text class="history-type type-{{item.type}}">{{item.type === 'charger' ? '充电桩故障' : item.type === 'environment' ? '环境问题' : '其他'}}</text>
          <text class="history-status status-{{item.status}}">{{item.status === 'pending' ? '待处理' : item.status === 'processing' ? '处理中' : item.status === 'resolved' ? '已解决' : item.status}}</text>
        </view>
        <view class="history-title">{{item.title}}</view>
        <view class="history-content">{{item.content}}</view>
        <view class="history-time">{{item.createTime || item.time}}</view>
      </view>
    </view>
    <view class="empty" wx:if="{{!loading && feedbackList.length === 0}}">
      <text>暂无反馈记录</text>
    </view>
  </view>
</view>
