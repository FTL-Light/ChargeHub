<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar" bindtap="onSearchTap">
    <view class="search-inner">
      <text class="iconfont icon-search">🔍</text>
      <text class="search-placeholder">搜索充电站名称或地址</text>
    </view>
    <text class="city-text">{{currentCity}}</text>
  </view>

  <!-- 扫码充电按钮 -->
  <view class="scan-section">
    <view class="scan-btn" bindtap="onScanCharge">
      <view class="scan-icon">⚡</view>
      <view class="scan-text">
        <view class="scan-title">扫码充电</view>
        <view class="scan-desc">扫描充电桩二维码立即开始</view>
      </view>
      <view class="scan-arrow">›</view>
    </view>
  </view>

  <!-- 附近充电站标题 -->
  <view class="section-title">
    <text class="title-text">附近充电站</text>
    <text class="title-count" wx:if="{{stations.length > 0}}">共{{stations.length}}个</text>
  </view>

  <!-- 站点列表 -->
  <view class="station-list" wx:if="{{stations.length > 0}}">
    <view
      class="station-card"
      wx:for="{{stations}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onStationTap"
    >
      <image
        class="station-img"
        src="{{item.image || item.imageUrl || '/images/station-default.png'}}"
        mode="aspectFill"
      ></image>
      <view class="station-info">
        <view class="station-name">{{item.name}}</view>
        <view class="station-address">📍 {{item.address || '暂无地址'}}</view>
        <view class="station-meta">
          <text class="meta-item">充电桩 {{item.chargerCount || item.totalChargers || 0}}</text>
          <text class="meta-divider">|</text>
          <text class="meta-item available">空闲 {{item.availableCount || item.available || 0}}</text>
          <text class="meta-divider" wx:if="{{item.distance}}">|</text>
          <text class="meta-item distance" wx:if="{{item.distance}}">{{item.distance}}</text>
        </view>
      </view>
      <view class="station-status {{item.status === 1 || item.status === '正常' ? 'online' : 'offline'}}">
        {{item.status === 1 || item.status === '正常' ? '营业中' : '休息中'}}
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && stations.length === 0}}">
    <view class="empty-icon">🔌</view>
    <view class="empty-text">附近暂无充电站</view>
    <view class="empty-desc">下拉刷新试试看</view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-text">加载中...</view>
  </view>
</view>
