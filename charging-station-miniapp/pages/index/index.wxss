.container {
  padding-bottom: 30rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #1890ff;
}

.search-inner {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 0 30rpx;
}

.search-inner .icon-search {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  color: #999;
  font-size: 28rpx;
}

.city-text {
  color: #ffffff;
  font-size: 26rpx;
  margin-left: 20rpx;
  padding: 0 10rpx;
}

/* 扫码充电按钮 */
.scan-section {
  padding: 24rpx 30rpx;
}

.scan-btn {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3);
}

.scan-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  font-size: 44rpx;
  margin-right: 24rpx;
}

.scan-text {
  flex: 1;
}

.scan-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.scan-desc {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
}

.scan-arrow {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 200;
}

/* 区块标题 */
.section-title {
  display: flex;
  align-items: center;
  padding: 10rpx 30rpx 20rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.title-count {
  font-size: 24rpx;
  color: #999;
}

/* 站点卡片 */
.station-list {
  padding: 0 30rpx;
}

.station-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.station-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.station-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.station-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.station-address {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.station-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.meta-item {
  color: #666;
}

.meta-item.available {
  color: #52c41a;
}

.meta-item.distance {
  color: #1890ff;
}

.meta-divider {
  color: #ddd;
  margin: 0 12rpx;
}

.station-status {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.station-status.online {
  color: #52c41a;
  background: rgba(82, 196, 26, 0.1);
}

.station-status.offline {
  color: #999;
  background: rgba(0, 0, 0, 0.05);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999;
}

/* 加载中 */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}
