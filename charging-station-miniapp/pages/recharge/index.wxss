.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
}

/* 余额卡片 */
.balance-card {
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  border-radius: 20rpx;
  padding: 50rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.2);
}

.balance-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 16rpx;
}

.balance-value {
  font-size: 72rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 2rpx;
}

/* 充值区域 */
.recharge-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.quick-amounts {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 30rpx;
}

.amount-item {
  width: calc(50% - 12rpx);
  margin-right: 24rpx;
  margin-bottom: 20rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f7fa;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.amount-item:nth-child(2n) {
  margin-right: 0;
}

.amount-item.active {
  background: rgba(24, 144, 255, 0.08);
  border-color: #1890ff;
}

.amount-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-right: 6rpx;
}

.amount-item.active .amount-num {
  color: #1890ff;
}

.amount-unit {
  font-size: 24rpx;
  color: #666;
}

.amount-item.active .amount-unit {
  color: #1890ff;
}

.custom-amount {
  margin-bottom: 30rpx;
}

.custom-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.input-wrap {
  display: flex;
  align-items: center;
  height: 88rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.input-prefix {
  font-size: 32rpx;
  color: #333;
  margin-right: 12rpx;
  font-weight: bold;
}

.amount-input {
  flex: 1;
  height: 88rpx;
  font-size: 32rpx;
  color: #333;
}

.recharge-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 45rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3);
}

.recharge-btn.disabled {
  background: #d9d9d9;
  color: #999;
  box-shadow: none;
}

/* 充值记录 */
.record-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.record-list {
  width: 100%;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  flex: 1;
}

.record-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #52c41a;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}
