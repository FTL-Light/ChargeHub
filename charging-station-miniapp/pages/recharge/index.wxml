<view class="container">
  <!-- 余额卡片 -->
  <view class="balance-card">
    <view class="balance-label">账户余额（元）</view>
    <view class="balance-value">{{balance}}</view>
  </view>

  <!-- 充值金额选择 -->
  <view class="recharge-section">
    <view class="section-title">选择充值金额</view>
    <view class="quick-amounts">
      <view
        class="amount-item {{selectedAmount === item ? 'active' : ''}}"
        wx:for="{{quickAmounts}}"
        wx:key="*this"
        data-amount="{{item}}"
        bindtap="onQuickAmount"
      >
        <text class="amount-num">{{item}}</text>
        <text class="amount-unit">元</text>
      </view>
    </view>

    <view class="custom-amount">
      <text class="custom-label">自定义金额</text>
      <view class="input-wrap">
        <text class="input-prefix">¥</text>
        <input
          class="amount-input"
          type="digit"
          placeholder="请输入充值金额"
          value="{{amount}}"
          bindinput="onAmountInput"
        />
      </view>
    </view>

    <view
      class="recharge-btn {{(!amount || submitting) ? 'disabled' : ''}}"
      bindtap="onRecharge"
    >
      <text>{{submitting ? '充值中...' : '立即充值'}}</text>
    </view>
  </view>

  <!-- 充值记录 -->
  <view class="record-section">
    <view class="section-title">充值记录</view>
    <view class="record-list" wx:if="{{rechargeList.length > 0}}">
      <view class="record-item" wx:for="{{rechargeList}}" wx:key="id">
        <view class="record-left">
          <view class="record-title">账户充值</view>
          <view class="record-time">{{item.createTime || item.time}}</view>
        </view>
        <view class="record-amount">+¥{{item.amount}}</view>
      </view>
    </view>
    <view class="empty" wx:if="{{!loading && rechargeList.length === 0}}">
      <text>暂无充值记录</text>
    </view>
  </view>
</view>
