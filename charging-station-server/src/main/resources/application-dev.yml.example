# 复制本文件为 application-dev.yml，并填入你自己的本地配置。
# application-dev.yml 已被 .gitignore 忽略，不会被提交到仓库。
spring:
  datasource:
    username: root
    password: 你的MySQL密码
  data:
    redis:
      host: localhost
      port: 6379
      password: 你的Redis密码（无密码可删除本行）
jwt:
  secret: 你的JWT密钥（至少256位）
ai:
  api-key: 你的DeepSeek API Key
# 模拟支付开关：本地/演示环境保持 true；生产环境必须改为 false 并接入真实支付网关
pay:
  mock-enabled: true
